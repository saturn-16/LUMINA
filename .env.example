# ==============================================================================
# TICKET BOOKING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration
# Use PostgreSQL in production or SQLite for zero-configuration local development.
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/ticket_booking
# Example SQLite: sqlite+aiosqlite:///./ticket_booking.db
DATABASE_URL=sqlite+aiosqlite:///./ticket_booking.db
SYNC_DATABASE_URL=sqlite:///./ticket_booking.db

# Application & Security Settings
PROJECT_NAME="Ticket Booking System"
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business Logic Configuration
# Hold TTL in seconds (e.g. 600 = 10 minutes)
HOLD_TTL_SECONDS=600
# Waitlist Offer TTL in seconds (e.g. 600 = 10 minutes)
WAITLIST_OFFER_TTL_SECONDS=600

# Background Worker Settings
EXPIRY_CLEANUP_INTERVAL_SECONDS=15

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend URL (for email links like waitlist offers and tickets)
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (SMTP)
# If SMTP_HOST is empty or invalid, system runs in dev mode (logs emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ticketbooking.example.com
SMTP_FROM_NAME="Ticket Booking System"
SMTP_TLS=true
